# Ulla-Bella Adapter secrets (Task 13).
# Values are literal: no quotes, no shell expansion (systemd EnvironmentFile
# semantics). This file MUST stay 0600 root:root and is never committed to Git.
# Each name below is referenced from /etc/ulla-bella/adapter.yaml.

# Agent credential minted by `relay agent create <id>` on the Relay operator CLI.
# It exists only on this machine (agent-side); it is never in Git or logs.
ULLABELLA_AGENT_CREDENTIAL=

# Hermes API key (local Hermes gateway, http://127.0.0.1:8642/v1).
API_SERVER_KEY=

# YOOtheme MCP Bearer token for the pilot Site.
YTB_MCP_TOKEN=
